# Supply-chain hardening (mini Shai-Hulud 2nd-wave, https://blog.flatt.tech/entry/mini_shai_hulud_2nd).
# Bun is the package manager and blocks transitive lifecycle scripts by default
# (trustedDependencies model). These directives protect contributors who fall
# back to npm / yarn / pnpm.

# Block lifecycle scripts (preinstall/install/postinstall/prepare) — the main
# defense against a malicious transitive dep exfiltrating credentials on install.
ignore-scripts=true

# Block package versions published < 7 days ago (npm 11+). Shai-Hulud-style
# attacks are widely picked up within hours; this delay buys an incident-response
# window. Ignored by older npm (no harm).
min-release-age=168h

# Warn on moderate+ advisories (use --audit-level=high to fail).
audit-level=moderate
