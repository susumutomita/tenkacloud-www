# Example variables. Prefer the .env.terraform flow (`make provision`), which
# injects these as TF_VAR_* environment variables — see .env.terraform.example.
# Secrets (CLOUDFLARE_API_TOKEN) are env-only, never in a committed file.

cloudflare_account_id = "your-cloudflare-account-id"
contact_to            = "your-gmail@gmail.com"

# Optional overrides:
# zone_name          = "tenkacloud.com"
# pages_project_name = "tenkacloud-www"
# contact_from       = "contact@tenkacloud.com"
