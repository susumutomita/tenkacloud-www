# Copy to .env.terraform (git-ignored) and fill in. `make provision` sources it.
#
# Create the API token at https://dash.cloudflare.com/profile/api-tokens with:
#   Account | Cloudflare Pages          | Edit
#   Account | Email Routing Addresses   | Edit
#   Zone    | DNS                       | Edit
#   Zone    | Email Routing Rules       | Edit
# (scoped to your account and the tenkacloud.com zone)

CLOUDFLARE_API_TOKEN=your-api-token
TF_VAR_cloudflare_account_id=your-cloudflare-account-id
TF_VAR_contact_to=your-gmail@example.com
